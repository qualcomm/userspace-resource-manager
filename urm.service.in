[Unit]
Description=URM Service
DefaultDependencies=no
After=sysinit.target

[Service]
Restart=on-failure
RuntimeDirectory=urm
RuntimeDirectoryMode=0755
ExecStart=@CMAKE_INSTALL_FULL_SBINDIR@/urm
ExecStartPre=-/sbin/restorecon @CMAKE_INSTALL_FULL_SBINDIR@/urm
ExecStartPre=-/usr/libexec/urm/initscripts/post_boot/post_boot.sh
TimeoutStopSec=2
Delegate=yes
Slice=urm.slice

[Install]
WantedBy=multi-user.target
