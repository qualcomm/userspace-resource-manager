[Unit]
Description=URM Service
DefaultDependencies=no
After=sysinit.target

[Service]
Restart=on-failure
ExecStartPre=+systemd-tmpfiles --create urm.conf
ExecStartPre=-/usr/libexec/urm/initscripts/post_boot/post_boot.sh
ExecStart=@CMAKE_INSTALL_FULL_SBINDIR@/urm
TimeoutStopSec=2
Delegate=yes
Slice=urm.slice

[Install]
WantedBy=multi-user.target
